                            <div class="fw-bold projectPrice">$6,850</div>
                            <small class="text-muted totalPercentage">5% of total</small>
                        </div>
                    </div> *@

                </div>
            </div>

            <!-- Monthly Cost Trend -->
            @*  <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-4">Monthly Cost Trend</h6>
                        <div class="bg-light text-center rounded p-5">
                            <i class="bi bi-bar-chart fs-1 text-muted"></i>
                            <p class="text-muted mb-0">Chart visualization would be implemented here</p>
                            <small class="text-muted">Integration with Chart.js or Recharts</small>
                        </div>
                    </div>
                </div> *@

        </div>
    </div>


    <div class="tab-pane fade " id="pills-rentals" role="tabpanel">
        <div class="ActiveRental">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Active Rentals</h5>

                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-uppercase small">
                            <tr>
                                <th>Order</th>
                                <th>Item</th>
                                <th>Project</th>
                                <th>Due Date</th>
                                <th>Days Left</th>
                                <th>Daily Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model.ActiveRentals)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@item.Order</td>
                                        <td>@item.Item</td>
                                        <td>@item.Project</td>
                                        <td>@(item.DueDate.HasValue ? item.DueDate.Value.ToShortDateString() : "N/A")</td>
                                        <td><span class="text-dark fw-medium">@item.DaysLeft</span></td>
                                        <td>$@item.DailyCost</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td>There are currently no active rentals available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade " id="pills-alert" role="tabpanel">
        <div class="AlertFlags">

            <!-- Budget Alert: 85% -->
            <div class="alert alert-warning border border-warning-subtle rounded-3">
                <div class="fw-bold alertTitle">
                    <i class="fa fa-warning me-2"></i>
                    Budget Alert
                </div>
                <div class="alertInfo">Pipeline Installation project is at 85% of budget</div>
                <div class="text-muted small AltName">Project: Pipeline Installation Phase 1</div>
            </div>

            <!-- Overdue Return -->
            <div class="alert alert-danger border border-danger-subtle rounded-3">
                <div class="fw-bold alertTitle">
                    <i class="fa fa-warning me-2"></i>
                    Overdue Return
                </div>
                <div class="alertInfo">Generator 50KW is 1 day overdue for return</div>
                <div class="text-muted small AltName">Project: Remote Site</div>
            </div>

            <!-- Budget Alert: 80% -->
            <div class="alert alert-warning border border-warning-subtle rounded-3">
                <div class="fw-bold alertTitle">
                    <i class="fa fa-warning me-2"></i>
                    Budget Alert
                </div>
                <div class="alertInfo">Construction Site A approaching 80% budget threshold</div>
                <div class="text-muted small AltName">Project: Construction Site A</div>
            </div>

            <!-- Due Soon -->
            <div class="alert alert-primary border border-primary-subtle rounded-3">
                <div class="fw-bold alertTitle">
                    <i class="fa fa-warning me-2"></i>
                    Due Soon
                </div>
                <div class="alertInfo">Forklift 5000lb due for return tomorrow</div>
                <div class="text-muted small AltName">Project: Warehouse Setup</div>
            </div>

        </div>
    </div>
</div>

