                        </div>
                        <div class="text-end">
                            <div class="fw-bold projectPrice">$34,200</div>
                            <small class="text-muted totalPercentage">27% of total</small>
                        </div>
                    </div> *@

                    <!-- Project 3 -->
                    @* <div class="d-flex justify-content-between align-items-center bg-light rounded p-3 my-2">
                        <div>
                            <span class="fw-semibold projectName">Maintenance Work</span>
                            <div class="progress mb-3" style="height: 6px;">
                                <div class="progress-bar green"
                                     role="progressbar"
                                     style="width: 15%;"
                                     aria-valuenow="15"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>

                        </div>
                        <div class="text-end">
                            <div class="fw-bold projectPrice">$18,900</div>
                            <small class="text-muted totalPercentage">15% of total</small>
                        </div>
                    </div> *@

                    <!-- Project 4 -->
                    @* <div class="d-flex justify-content-between align-items-center bg-light rounded p-3 my-2">
                        <div>
                            <span class="fw-semibold projectName">Emergency Repair</span>
                            <div class="progress mb-3" style="height: 6px;">
                                <div class="progress-bar green"
                                     role="progressbar"
                                     style="width: 5%;"
