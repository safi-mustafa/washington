<style>
    .reportFilter .nav-item .nav-link {
        background: #f3f4f6;
        color: #374151;
        font-size: .875rem;
        line-height: 1.25rem;
        margin-right: 14px;
    }

        .reportFilter .nav-item .nav-link.active {
            background: #f54e00;
            color: #ffffff;
        }

    .totalPercentage {
        font-size: 13px;
    }

    .projectPrice {
        font-size: 21px
    }

    .CostByProjectSection .progress-bar {
        background-color: #f54e00;
    }

    .costByStatus .progress-bar {
        background-color: #f54e00;
    }

    .projectName {
        font-size: 17px;
    }

    .ActiveRental .ontime {
        background-color: #dcfce7;
        color: #15803d;
        border-radius: 9999px;
        padding: 4px 8px;
    }

    .ActiveRental .overdue {
        background-color: #fee2e2;
        color: #b91c1c;
        border-radius: 9999px;
        padding: 4px 8px;
    }

    .ActiveRental .duesoon {
        background-color: #ffedd5;
        color: #c2410c;
        border-radius: 9999px;
        padding: 4px 8px;
    }

    .AlertFlags .alert-warning {
        border-color: #fef08a;
        background-color: #fefce8;
    }

        .AlertFlags .alert-warning .fa {
            color: #ca8a04;
        }

    .AlertFlags .alert-danger {
        border-color: #fecaca;
        background-color: #fef2f2;
    }

        .AlertFlags .alert-danger .fa {
            color: #dc2626;
        }

    .AlertFlags .alert-primary {
        border-color: #bfdbfe;
        background-color: #eff6ff;
    }

        .AlertFlags .alert-primary .fa {
            color: #2563eb;
        }

    .AlertFlags .alert .alertInfo {
        font-size: 15px;
        font-weight: 400;
    }

    .AlertFlags .alert .alertTitle {
        font-size: 18px;
    }

    .AlertFlags .alert .AltName {
        font-size: 14px;
        font-weight: 200;
    }

    .status span {
        font-size: 16px;
        font-weight: 500;
    }

        .status span.fw-bold {
            font-size: 18px;
            font-weight: 600;
        }

    .costByStatus .precentageShow {
        text-align: right;
        font-size: 14px;
        font-weight: 200;
    }

    .topCard .card h6 {
        font-size: 14px;
        font-weight: 500;
    }

    .topCard .card .iconSec {
        padding: 0.75rem;
        border-radius: 0.5rem;
        background-color: #f3f4f6;
        font-size: 16px;
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Reports</h3>
