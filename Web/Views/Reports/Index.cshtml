<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <!-- Status Tabs -->
    <ul class="nav nav-pills reportFilter" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-dashboard-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-dashboard" type="button" role="tab">
                <i class="fa fa-bar-chart me-1"></i>Overview Dashboard
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-cost-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-cost" type="button" role="tab">
                <i class="fa fa-dollar me-1"></i>Cost Analysis
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-rentals-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-rentals" type="button" role="tab">
                <i class="fa fa-box me-1"></i>Active Rentals
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-alert-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-alert" type="button" role="tab">
                <i class="fa fa-warning me-1"></i>Alerts & Flags
            </button>
        </li>


    </ul>
</div>

<!-- Orders List -->
<div class="tab-content" id="pills-tabContent">
    <div class="tab-pane fade show active" id="pills-dashboard" role="tabpanel">
        <!------------------------top card-------------->
        <div class="dashboard">
            <div class="row g-3 mb-4 topCard">
                <div class="col-md-3 totalOrder">
                    <div class="card shadow-sm p-3 ">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Total Orders</h6>
                                <h4>@Model.ReportsCount.TotalOrders</h4>
                                @* <small class="text-success"><i class="fa fa-arrow-up"></i> +12% from last month</small> *@
                            </div>
                            <div class="iconSec">
                                <i class="fa fa-bar-chart fs-3 text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 totalCost">
                    <div class="card shadow-sm p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Total Cost</h6>
                                <h4>$@Model.ReportsCount.TotalCost</h4>
                                @* <small class="text-success"><i class="fa fa-arrow-up"></i> +8% from last month</small> *@
                            </div>
                            <div class="iconSec">
                                <i class="fa fa-dollar fs-3 text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 ActiveRental">
                    <div class="card shadow-sm p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Active Rentals</h6>
                                <h4>@Model.ReportsCount.TotalActiveRentals</h4>
                                @* <small class="text-danger"><i class="fa fa-arrow-down"></i> -3% from last month</small> *@
                            </div>
                            <div class="iconSec">
                                <i class="fa fa-box fs-3 text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 OverdueReturn">
                    <div class="card shadow-sm p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Overdue Returns</h6>
                                <h4>3</h4>
                                @* <small class="text-success"><i class="fa fa-arrow-up"></i> +50% from last month</small> *@
                            </div>
                            <div class="iconSec">
                                <i class="fa fa-warning fs-3 text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="costByStatus">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Cost by Status</h6>
                        <div class="status rentStatus mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>On Rent</span>
                                <span class="fw-bold">$@Model.CostbyOnRent.TotalOrderCost</span>
                            </div>
                            <div class="progress mb-1" style="height: 12px;">
                                <div class="progress-bar "
                                     role="progressbar"
                                     style="width: @Model.CostbyOnRent.PercentageComplete%;"
                                     aria-valuenow="@Model.CostbyOnRent.PercentageComplete"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            @* <div class="mb-2 precentageShow">35%</div> *@

                        </div>
                        <div class="status deliveredStatus mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Delivered</span>
                                <span class="fw-bold">$@Model.CostbyDelivered.TotalOrderCost</span>
                            </div>
                            <div class="progress mb-1" style="height: 12px;">
                                <div class="progress-bar green"
                                     role="progressbar"
                                     style="width: @Model.CostbyDelivered.PercentageComplete%;"
                                     aria-valuenow="@Model.CostbyDelivered.PercentageComplete"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            @* <div class="precentageShow mb-2">16%</div> *@

                        </div>
                        <div class="status ScheduledStatus mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Scheduled</span>
                                <span class="fw-bold">$@Model.CostbyScheduled.TotalOrderCost</span>
                            </div>
                            <div class="progress mb-1" style="height: 12px;">
                                <div class="progress-bar green"
                                     role="progressbar"
                                     style="width: @Model.CostbyScheduled.PercentageComplete%;"
                                     aria-valuenow="@Model.CostbyScheduled.PercentageComplete"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            @* <div class="mb-2 precentageShow">25%</div> *@

                        </div>
                        <div class="status PendingStatus mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Pending</span>
                                <span class="fw-bold">$@Model.CostbyPending.TotalOrderCost</span>
                            </div>
                            <div class="progress mb-1" style="height: 12px;">
                                <div class="progress-bar green"
                                     role="progressbar"
                                     style="width: @Model.CostbyPending.PercentageComplete%;"
                                     aria-valuenow="@Model.CostbyPending.PercentageComplete"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            @* <div class="precentageShow mb-2">22%</div> *@

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="tab-pane fade " id="pills-cost" role="tabpanel">
        <div class="CostByProjectSection">

            <!-- Cost by Project -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-bold  mb-4">Cost by Project</h6>
                    @if (Model != null)
                    {
                        @foreach (var item in Model.CustomerProjects)
                        {
                            <div class="d-flex justify-content-between align-items-center bg-light rounded p-3 my-2">
                                <div>
                                    <div class="fw-semibold mb-2 projectName">@item.JobName</div>
                                    <div class="progress mb-1" style="height: 12px;">
                                        <div class="progress-bar green"
                                             role="progressbar"
                                             style="width: @item.PercentageComplete%;"
                                             aria-valuenow="@item.PercentageComplete"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold projectPrice">$@item.TotalCost</div>
                                    @* <small class="text-muted totalPercentage">53% of total</small> *@
                                </div>
                            </div>
                        }
                    }
                    <!-- Project 1 -->
                    @*  <div class="d-flex justify-content-between align-items-center bg-light rounded p-3 my-2">
                        <div>
                            <div class="fw-semibold mb-2 projectName">Pipeline Installation Phase 1</div>
