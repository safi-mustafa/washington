<style>

    .setting-page-search.filter_wrap form > div {
        border-radius: 4px;
    }

    .setting-page-search.filter_wrap form.filter input:not([type="checkbox"]) {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #8898AA;
    }

    .reportFilter .control_field {
        width: 100%;
        border-radius: 10px;
        border-color: #8898AA;
        color: #8898AA;
        background: #fff;
    }

    .reportFilter {
        margin: 0;
        padding: 0;
    }

    .filter_wrap form.filter select {
        height: 36px;
        border: 1px solid #8898AA !important;
    }

    .headerSec i.fa{
        margin-right:10px;
    }

    .viewDetail{
        color:#f54e00;
    }

    #viewReportDetails .modal-dialog.modal-lg{
        width:500px !important;
    }
</style>
<div class="report-list-table">

    <div class="d-flex justify-content-between align-items-center mb-3 headerSec">
        <h3>Reports</h3>
        <a href="/Inventories" class="btn btn-primary"><i class="fa fa-file-export"></i>Export</a>
    </div>
    <div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
        <!-- Filter -->
        <div class="filter_wrap setting-page-search reportFilter">
            <form class=" filter search-form" id="report-filter-form" method="post">
                <div class="control_field">
                    <input type="search" class="form-control" placeholder="Search" autocomplete="new-password" id="Search_value" value="">
                </div>
                <div class="control_field">
                    <input type="search" class="form-control" placeholder="OrderId" autocomplete="new-password" id="Search_value" value="">
                </div>

                <div class="control_field">
                    <div class="form-group">

                        <select class="form-control text-xs px-2 py-1 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500" placeholder="Customer Name">
                            <option value="Customer Name 1">Customer Name 1</option>
                            <option value="Customer Name 2">Customer Name 2</option>
                            <option value="Customer Name 3">Customer Name 3</option>
                        </select>
                    </div>
                </div>
                <div class="control_field">
                    <div class="form-group">

                        <select class="form-control text-xs px-2 py-1 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500" placeholder="Project Name">
                            <option value="Project Name 1">Project Name 1</option>
                            <option value="Project Name 2">Project Name 2</option>
                            <option value="Project Name 3">Project Name 3</option>
                        </select>
                    </div>
                </div>
                



                <div class="actions_field">
                    <button class="clear btn clear-form-btn border text-primary">
                        Clear
                    </button>
                    <button type="button" class="btn btn-primary search-form-btn">
                        Search
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table dataTable">
            <thead class=" text-center">
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Project Name</th>
                    <th>Purchase Order</th>
                    <th>Item Type</th>
                    <th>Asset Tag / Material Supplier</th>
                    <th>Qty</th>
                    <th>Rental Start Date</th>
                    <th>Rental End Date</th>
                    <th>Total Cost</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ORD001</td>
                    <td>John Doe</td>
                    <td>Highway Expansion</td>
                    <td>PO12345</td>
                    <td>Excavator</td>
                    <td>CAT / ABC Rentals</td>
                    <td>3</td>
                    <td>2025-08-20</td>
                    <td>2025-09-05</td>
                    <td>$12,000</td>
                    <td><a data-bs-toggle="modal" data-bs-target="#viewReportDetails"><div class="viewDetail">View</div></a></td>
                </tr>
                <tr>
                    <td>ORD002</td>
                    <td>Jane Smith</td>
                    <td>Bridge Project</td>
                    <td>PO67890</td>
                    <td>Generator</td>
                    <td>Honda / XYZ Supplies</td>
                    <td>5</td>
                    <td>2025-08-22</td>
                    <td>2025-08-30</td>
                    <td>$4,500</td>
                    <td><a data-bs-toggle="modal" data-bs-target="#viewReportDetails"><div class="viewDetail">View</div></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

