@model ViewModels.OrderModifyViewModel
@{
    var orderItems = Model.OrderItems.ToList();
}
<style>
    .stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .ProgressTitle {
        display: flex;
        align-items: center;
    }

    .step.active {
        color: #f54e00;
    }

    .step .icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e9ecef;
        margin-right: 8px;
    }

    .step.active .icon {
        background-color: #f54e00;
        color: #fff;
    }

    .step.completed .icon {
        background-color: #198754;
        color: #fff;
    }

    .step.completed .line {
        background-color: #198754;
        color: #fff;
    }

    .line {
        flex: 1;
        height: 3px;
        margin: 0 26px;
        background-color: #b2b2b2;
        width: 19vw;
    }
</style>
<h4 class="text-xl font-bold text-gray-900  mb-4">Checkout</h4>
<!---------------new----------------->
<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <div class="stepper mb-0">
        <div class="flex-1 d-flex align-items-center step active">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-cart-shopping"></i></div>
                Review Cart
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step">
            <div class="ProgressTitle ">
                <div class="icon"><i class="fa fa-pencil"></i></div>
                Order Details
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-check-circle"></i></div>
                Review & Submit
            </div>
        </div>
    </div>
</div>

<div class="Steps-Detail">

    <div class="card">
        <div class="card-body">
            <div class="mb-3 bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Review Cart Items</h5>
                <a href="/Inventories" class="text-primary fw-bold">Continue Shopping</a>
            </div>
            <div class="row">
                @if (orderItems.Count > 0)
                {
                    for (int i = 0; i < orderItems.Count; i++)
                    {
                        var item = orderItems[i];
                        var collectionName = $"OrderItems[{i}].";
                        var quantityName = collectionName + "Quantity";
                        @if (item.Inventory.Id > 0)
                        {
                            var orderIdName = collectionName + "Inventory.Id";
                            <input type="hidden" name="@orderIdName" value="@item.Inventory.Id" />
                            <input type="hidden" name="OrderItems[@i].ItemName" value="@item.Inventory.ItemNo" />
                            <div class="col-12">
                                <div class="d-flex p-3 border rounded mb-3">
                                    <input type="hidden" name="inventoryrateonetime_@i" value="@item.Inventory.UnitCost" />
                                    <img src="@(string.IsNullOrWhiteSpace(item.Inventory?.ImageUrl) ? "/img/no-img.jpg" : item.Inventory.ImageUrl)" alt="itemImg" class="me-3" style="width:100px; height:auto;" />
                                    <div class="flex-grow-1">
                                        <h5>@item.Inventory.ItemNo</h5>
                                        <small>Inventory</small>
                                        <div class="row mt-2">
                                            <div class="col-md-3">
                                                <label>Delivary Date</label>
                                                <input type="date" class="form-control start-date"
                                                       name="OrderItems[@i].StartDate"
                                                       value="@item.Inventory.StartDate?.ToString("yyyy-MM-dd")" />
                                            </div>
                                            @* <div class="col-md-3">
                                                <label>End Date</label>
                                                <input type="date" class="form-control end-date"
                                                       name="OrderItems[@i].EndDate"
                                                       value="@item.Inventory.EndDate?.ToString("yyyy-MM-dd")" />
                                            </div> *@
                                            <div class="col-md-3">
                                                <label>Frequency</label>
                                                <select class="form-select" name="OrderItems[@i].Frequency" disabled>
                                                    <option selected>One-Time</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label>Quantity</label>
                                                <input name="@quantityName" class="form-control quantity" type="number" value="@item.Quantity" min="1" max="@item.OHQuantity" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <h5 class="text-primary cart-total">$0</h5>
                                        <small>per unit</small>
                                        <div class="text-center">
                                            <a class="text-danger" href="javascript:void(0)" onclick="deleteInventoryFromCart(@item.Inventory.Id, this)">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            var orderIdName = collectionName + "Equipment.Id";
                            <input type="hidden" name="@orderIdName" value="@item.Equipment.Id" />
                            <input type="hidden" name="OrderItems[@i].ItemName" value="@item.Equipment.ItemNo" />

                            <div class="col-12">
                                <div class="d-flex p-3 border rounded mb-3">
                                    <input type="hidden" name="equipmentratedaily_@i" value="@item.Equipment.DefaultRentalRateDaily" />
                                    <input type="hidden" name="equipmentrateweekly_@i" value="@item.Equipment.DefaultRentalRateWeekly" />
                                    <input type="hidden" name="equipmentratemonthly_@i" value="@item.Equipment.DefaultRentalRateMonthly" />
                                    <img src="@(string.IsNullOrWhiteSpace(item.Equipment?.ImageUrl) ? "/img/no-img.jpg" : item.Equipment.ImageUrl)" alt="itemImg" class="me-3" style="width:100px; height:auto;" />
                                    <div class="flex-grow-1">
                                        <h5>@item.Equipment.ItemNo</h5>
                                        <small>Equipment</small>
                                        <div class="row mt-2">
                                            <div class="col-md-3">
                                                <label>Start Date</label>
                                                <input type="date" class="form-control start-date"
                                                       name="OrderItems[@i].StartDate"
                                                       value="@item.Equipment.StartDate?.ToString("yyyy-MM-dd")" />
                                            </div>
                                            <div class="col-md-3">
                                                <label>End Date</label>
                                                <input type="date" class="form-control end-date"
                                                       name="OrderItems[@i].EndDate"
                                                       value="@item.Equipment.EndDate?.ToString("yyyy-MM-dd")" />
                                            </div>
                                            <div class="col-md-3">
                                                <label>Frequency</label>
                                                <select class="form-select" name="OrderItems[@i].Frequency" disabled>
                                                    <option selected>Daily</option>
                                                    <option>Weekly</option>
                                                    <option>Monthly</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label>Quantity</label>
                                                <input name="@quantityName" class="form-control" type="number" value="@item.Quantity" min="1" max="@item.OHQuantity" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <h5 class="text-primary cart-total">$0</h5>
                                        <small>per unit</small>
                                        <div class="text-center">
                                            <a class="text-danger" href="javascript:void(0)" onclick="deleteEquipmentFromCart(@item.Equipment.Id, this)">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <tr><td colspan="6">No Inventory Selected.</td></tr>
                }

            </div>
            <div class="bg-light p-3 rounded ">
                <div class="d-flex justify-content-between">
                    <h5>Total Estimated Cost:</h5>
                    <h4 class="fw-bold text-primary">$0</h4>
                </div>
                <small>Final pricing will be confirmed after review</small>
            </div>

            <div class="mt-3 d-flex justify-content-between">
                <a href="/Inventories" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Continue Shopping
                </a>
                <button type="button" class="btn btn-primary" onclick="proceedToStep2()">
                    Proceed to Details
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
        restoreStep1Data();
    });
    
    function restoreStep1Data() {
        $.ajax({
            url: '/Cart/GetStep1Data',
            type: 'GET',
            success: function(response) {
                if (response.success && response.data) {
                    console.log('Restoring data:', response.data);
                    response.data.Items.forEach(function(item) {
                        console.log('Processing item:', item);
                        if (item.Type === 'display' && item.Name.startsWith('cartTotal_')) {
                            let index = item.Name.split('_')[1];
                            $(".cart-total").eq(index).text(item.Value);
                        } else {
                            let input = $("input[name='" + item.Name + "'], select[name='" + item.Name + "']");
                            console.log('Found input:', input.length, 'for name:', item.Name);
                            if (input.length > 0) {
                                input.val(item.Value);
                                console.log('Set value:', item.Value, 'to field:', item.Name);
                            } else {
                                console.log('Field not found:', item.Name);
                            }
                        }
                    });
                    
                    if (response.data.TotalCost) {
                        $(".bg-light .fw-bold.text-primary").text(response.data.TotalCost);
                    }
                }
            }
        });
    }
    
    $(document).on("change", ".start-date, .end-date, input[type='number']", function () {
        let row = $(this).closest(".row");
        let container = $(this).closest(".d-flex");
        let startDate = row.find(".start-date").val();
        let endDate = row.find(".end-date").val();
        
        // Extract row index from the input name
        let inputName = $(this).attr('name');
        let rowIndex = inputName.match(/\[(\d+)\]/)[1];
        
        let inventoryRateOneTime = container.find(`[name="inventoryrateonetime_${rowIndex}"]`).val() || 0;
        let equipmentratedaily = container.find(`[name="equipmentratedaily_${rowIndex}"]`).val() || 0;
        let equipmentrateweekly = container.find(`[name="equipmentrateweekly_${rowIndex}"]`).val() || 0;
        let equipmentratemonthly = container.find(`[name="equipmentratemonthly_${rowIndex}"]`).val() || 0;
        let quantity = row.find('input[type="number"]').val() || 0;
        
        // Determine page type based on which hidden inputs exist
        let page = inventoryRateOneTime > 0 ? "Inventory" : "Equipment";
        
        // Check if this is a quantity change or date change
        let isQuantityChange = $(this).attr('type') === 'number';
        let isDateChange = $(this).hasClass('start-date') || $(this).hasClass('end-date');
        let inventoryDateCalculated = page === "Inventory" && container.data('calculated');
        
        // For quantity changes, calculate difference and update total directly
        if (isQuantityChange && container.data('unitPrice')) {
            let currentTotal = parseFloat($(".bg-light .fw-bold.text-primary").text().replace(/[^0-9.]/g, '')) || 0;
            let previousQty = container.data('previousQty') || 1;
            let unitPrice = container.data('unitPrice');
            let qtyDiff = quantity - previousQty;
            let newTotal = currentTotal + (qtyDiff * unitPrice);
            
            container.data('previousQty', quantity);
            row.closest(".d-flex").find(".text-primary").text(`$${(unitPrice * quantity)}`);
            $(".bg-light .fw-bold.text-primary").text(`$${newTotal}`);
            return;
        }
        

        
        // Skip AJAX for inventory date changes after first calculation
        if (inventoryDateCalculated && !isQuantityChange) return;
        
        // For Equipment, require both start and end dates
        if (page === "Equipment" && (!startDate || !endDate)) return;

        if (startDate) {
            if (!endDate && page === "Inventory") {
                endDate = startDate;
            }
            $.ajax({
                url: '/Cart/CalculateRent',
                type: 'POST',
                data: {
                    startDate: startDate,
                    endDate: endDate,
                    onetime: inventoryRateOneTime,
                    dailyRate: equipmentratedaily,
                    weeklyRate: equipmentrateweekly,
                    monthlyRate: equipmentratemonthly,
                    quantity: quantity,
                    page: page
                },
                success: function (res) {
                    row.find("select").val(res.frequency);
                    
                    // Calculate cart total difference for date changes
                    if (isDateChange && container.data('previousTotal')) {
                        let currentCartTotal = parseFloat($(".bg-light .fw-bold.text-primary").text().replace(/[^0-9.]/g, '')) || 0;
                        let previousItemTotal = container.data('previousTotal');
                        let newCartTotal = currentCartTotal - previousItemTotal + res.totalRent;
                        
                        row.closest(".d-flex").find(".text-primary").text(`$${res.totalRent}`);
                        $(".bg-light .fw-bold.text-primary").text(`$${newCartTotal}`);
                    } else {
                        row.closest(".d-flex").find(".text-primary").text(`$${res.totalRent}`);
                        
                        let cartTotal = 0;
                        $(".cart-total").each(function () {
                            let priceText = $(this).text();
                            let price = parseFloat(priceText.replace(/[^0-9.]/g, '')) || 0;
                            cartTotal += price;
                        });
                        $(".bg-light .fw-bold.text-primary").text(`$${cartTotal}`);
                    }
                    
                    // Store data for future calculations
                    container.data('unitPrice', res.totalRent / quantity);
                    container.data('previousQty', quantity);
                    container.data('previousTotal', res.totalRent);
                    
                    // Mark inventory as calculated
                    if (page === "Inventory") {
                        container.data('calculated', true);
                    }
                }
            });
        }
    });

    function deleteEquipmentFromCart(itemId, el) {
        if (confirm("Are you sure you want to remove this item?")) {
            $.ajax({
                url: '/Cart/DeleteEquipmentFromCart',
                type: 'POST',
                data: { id: itemId },
                success: function (res) {
                    if (res.success) {
                        clearSessionData(null, itemId);
                        if (res.redirectUrl) {
                            window.location.href = res.redirectUrl;
                        } else {
                            $(el).closest(".col-12").remove();
                            updateCartTotal();
                        }
                    } else {
                        alert("Failed to remove item.");
                    }
                }
            });
        }
    } // ✅ Closing brace added here

    function deleteInventoryFromCart(itemId, el) {
        if (confirm("Are you sure you want to remove this item?")) {
            $.ajax({
                url: '/Cart/DeleteInventoryFromCart',
                type: 'POST',
                data: { id: itemId },
                success: function (res) {
                    if (res.success) {
                        clearSessionData(itemId, null);
                        if (res.redirectUrl) {
                            window.location.href = res.redirectUrl;
                        } else {
                            $(el).closest(".col-12").remove();
                            updateCartTotal();
                        }
                    } else {
                        alert("Failed to remove item.");
                    }
                }
            });
        }
    }

    function proceedToStep2() {
        let formData = {
            items: [],
            totalCost: $(".bg-light .fw-bold.text-primary").text()
        };
        
        $(".card input, .card select").each(function() {
            let input = $(this);
            let name = input.attr('name');
            let value = input.val();
            
            if (name && value) {
                formData.items.push({
                    name: name,
                    value: value,
                    type: input.attr('type') || 'text'
                });
            }
        });
        
        $(".cart-total").each(function(index) {
            formData.items.push({
                name: `cartTotal_${index}`,
                value: $(this).text(),
                type: 'display'
            });
        });
        
        console.log('Form Data:', formData);
        
        if (formData.items.length === 0) {
            alert('No data to save');
            return;
        }
        
        $.ajax({
            url: '/Cart/SaveStep1DataSimple',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function(response) {
                if (response.success) {
                    window.location.href = '/Cart/Step2';
                } else {
                    alert('Error saving data: ' + (response.message || 'Unknown error'));
                }
            },
            error: function(xhr, status, error) {
                alert('Error saving data. Please try again.');
            }
        });
    }

    function clearSessionData(inventoryId, equipmentId) {
        $.ajax({
            url: '/Cart/ClearSessionData',
            type: 'POST',
            data: { inventoryId: inventoryId, equipmentId: equipmentId },
            success: function(response) {
                console.log('Session data managed:', response);
            }
        });
    }

    function updateCartTotal() {
        let cartTotal = 0;
        $(".cart-total").each(function () {
            let priceText = $(this).text();
            let price = parseFloat(priceText.replace(/[^0-9.]/g, '')) || 0;
            cartTotal += price;
        });
        $(".bg-light .fw-bold.text-primary").text(`$${cartTotal}`);
    }
</script>

