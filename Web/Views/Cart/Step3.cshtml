<h4 class="text-xl font-bold text-gray-900  mb-4">Checkout</h4>
<!---------------new----------------->
<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <div class="stepper mb-0">
        <div class="flex-1 d-flex align-items-center step completed">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-cart-shopping"></i></div>
                Review Cart
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step completed">
            <div class="ProgressTitle ">
                <div class="icon"><i class="fa fa-pencil"></i></div>
                Order Details
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step active">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-check-circle"></i></div>
                Review & Submit
            </div>
        </div>
    </div>
</div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Review & Submit Order</h5>

            <!-- Order Summary -->
            
            <div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
                    <h6 class="fw-semibold mb-3">Order Summary</h6>
                    <div class="row">
                        <div class="col-6 leftInfo">
                            <p class="mb-1">Project:</p>
                            <p class="mb-1">Project Code:</p>
                            <p class="mb-1">Items:</p>
                            <p class="mb-0">Estimated Total:</p>
                        </div>
                        <div class="col-6 text-end rightInfo">
                        <p class="mb-1">@Model.JobName</p>
                        <p class="mb-1">@Model.JobCode</p>
                            <p class="mb-1">@Model.Items</p>
                            <p class="mb-0 fs-5 fw-bold text-dark">@Model.EstimatedTotal</p>
                        </div>
                    </div>
                </div>
           

            <!-- Items to Order -->

        <div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
            <h6 class="fw-semibold mb-3">Items to Order</h6>

            <div class="row">
                @if (Model?.OrderData != null && Model.OrderData.Any())
                {
                    foreach (var order in Model.OrderData)
                    {
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded" style="background-color: #f8f9fa;">
                                <div>
                                    <strong>@order.ItemName</strong>
                                    <div class="text-muted small">
                                        @order.StartDate?.ToString("yyyy-MM-dd")
                                        to
                                        @order.EndDate?.ToString("yyyy-MM-dd")
                                        • @order.Frequency
                                        • Qty: @order.Qty
                                    </div>
                                </div>
                                <div class="fw-semibold">
                                    @order.ItemPrice.ToString("C")
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-muted fst-italic">No items to order.</div>
                    </div>
                }
            </div>
        </div>


