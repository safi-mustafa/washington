<h4 class="text-xl font-bold text-gray-900  mb-4">Checkout</h4>

<div class="container mt-5">
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center p-5">

            <!-- Green Check Icon -->
            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="green" stroke-width="2">
                    <circle cx="12" cy="12" r="10" stroke="green" stroke-width="2" fill="none" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 13l3 3 7-7" stroke="green" stroke-width="2" />
                </svg>
            </div>

            <!-- Main Heading -->
            <h4 class="fw-semibold mb-2">Order Submitted Successfully!</h4>

            <!-- Subtext -->
            <p class="text-muted mb-1" style="font-size: 15px;font-weight: 400;">
                Your order has been submitted for review. You will receive a confirmation email shortly.
            </p>
            <p class="text-muted small">
                Redirecting to your orders in a few seconds...
            </p>
        </div>
    </div>
</div>

<script>
    setTimeout(function() {
        window.location.href = '/Reports/Index';
    }, 3000);
</script>

