<style>
    .leftInfo p{
        font-weight:400;
        color:#1a1a1a;
        font-size:16px;
    }

    .rightInfo p {
        font-weight:500;
        color:#000000;
        font-size:16px;
    }

    
    .stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .ProgressTitle {
        display: flex;
        align-items: center;
    }

    .step.active {
        color: #f54e00;
    }

    .step .icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e9ecef;
        margin-right: 8px;
    }

    .step.active .icon {
        background-color: #f54e00;
        color: #fff;
    }

    .step.completed .icon {
        background-color: #198754;
        color: #fff;
    }

    .step.completed .line {
        background-color: #198754;
        color: #fff;
    }

    .line {
        flex: 1;
        height: 3px;
        margin: 0 26px;
        background-color: #b2b2b2;
        width: 19vw;
    }


</style>
