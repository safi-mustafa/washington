<style>
    .stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .ProgressTitle {
        display: flex;
        align-items: center;
    }

    .step.active {
        color: #f54e00;
    }

    .step .icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e9ecef;
        margin-right: 8px;
    }

    .step.active .icon {
        background-color: #f54e00;
        color: #fff;
    }

    .step.completed .icon {
        background-color: #198754;
        color: #fff;
    }

    .step.completed .line {
        background-color: #198754;
        color: #fff;
    }

    .line {
        flex: 1;
        height: 3px;
        margin: 0 26px;
        background-color: #b2b2b2;
        width: 19vw;
    }
</style>
<h4 class="text-xl font-bold text-gray-900  mb-4">Checkout</h4>
<!---------------new----------------->
<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <div class="stepper mb-0">
        <div class="flex-1 d-flex align-items-center step completed">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-cart-shopping"></i></div>
                Review Cart
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step active">
            <div class="ProgressTitle ">
                <div class="icon"><i class="fa fa-pencil"></i></div>
                Order Details
            </div>
            <div class="line"></div>
        </div>
        <div class="flex-1 d-flex align-items-center step">
            <div class="ProgressTitle">
                <div class="icon"><i class="fa fa-check-circle"></i></div>
                Review & Submit
            </div>
        </div>
    </div>
</div>


<form id="step2Form" enctype="multipart/form-data">
    <div class="card p-4">

        <h5 class="mb-3 fw-bold">Order Details</h5>


        <div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
            <div class="mb-4">
                <h6 class="fw-bold mb-3">Select Project</h6>
                <select class="form-select" id="customer-project-select">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var selected = step2Data != null && step2Data.CustomerProjectId == Model[i].Id ? "selected" : "";
                        <option value="@Model[i].Id" selected="@selected">@Model[i].JobName</option>
                    }
                </select>
            </div>
        </div>

        <div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
            <h6 class="fw-bold mb-3">Order Notes & Attachments</h6>
            <label class="form-label mt-2">Special Instructions</label>
            <textarea name="SpecialInstructions" class="form-control" rows="3" placeholder="Add any special instructions or notes for this order...">@(step2Data?.SpecialInstructions ?? "")</textarea>

            <label class="form-label mt-3">Attachments</label>
            <input name="attachments" type="file" class="form-control" multiple>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Cart" asp-action="Step1" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Cart
            </a>
            <button type="button" id="nextBtn" class="btn btn-primary">Review Order</button>
        </div>
    </div>
</form>

<script>
    $(document).ready(function() {
        // Load session data on page load
        loadStep2SessionData();
        $('#nextBtn').click(function() {
            var formData = new FormData();

            // Get selected project ID
                var projectId = $("#customer-project-select").val() || 0;
            formData.append('CustomerProjectId', projectId);

            // Get special instructions
            var instructions = $('textarea[name="SpecialInstructions"]').val() || '';
            formData.append('SpecialInstructions', instructions);

            // Get attachments
            var fileInput = $('input[name="attachments"]')[0];
            if (fileInput.files.length > 0) {
                for (var i = 0; i < fileInput.files.length; i++) {
                    formData.append('attachments', fileInput.files[i]);
                }
            }

            $.ajax({
                url: '@Url.Action("SaveStep2Data", "Cart")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        window.location.href = '@Url.Action("Step3", "Cart")';
                    } else {
                        alert('Error saving data: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error saving data. Please try again.');
                }
            });
        });
    });

    function loadStep2SessionData() {
        $.ajax({
            url: '@Url.Action("GetStep2Data", "Cart")',
            type: 'GET',
            success: function(data) {
                if (data.success && data.step2Data) {
                    $('#customer-project-select').val(data.step2Data.customerProjectId || 0);
                    $('textarea[name="SpecialInstructions"]').val(data.step2Data.specialInstructions || '');
                }
            }
        });
    }
</script>
