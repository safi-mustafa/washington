@using ViewModels
@using ViewModels.Shared.Notes
@model List<INotesViewModel>

@{
    Layout = null;
    var EQTransactionID = ViewBag.EQTransaction;
}

@await Html.PartialAsync("~/Views/Shared/Notes/_NotesPartialView.cshtml", Model, new ViewDataDictionary(ViewData) { { "ParentId", EQTransactionID }, { "ParentName", "TransactionId" } })

<script src="~/js/views/notes/notes.js"></script>
<script>
    $(function () {
        notesUrl = "/Equipment/SaveShipmentTransactionNotes";
        closeNotesModalOnSubmit = false;
    })

    function getNotesList() {
        $.get("/Equipment/GetShipmentTransactionNotes/" + @EQTransactionID, function (response) {
            $("#notes-list-container tbody").html($(response).find("tbody").html());
        });
    }
</script>
