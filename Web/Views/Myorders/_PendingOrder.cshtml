@using ViewModels.MyOrder
@model List<AllOrderViewModel>

@if (Model != null)
{
    <input id="hdnCountPendingOrder" type="hidden" value="@Model.Count" />

    @foreach (var itemOrder in Model)
    {

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="mb-1 orderTitle">
                            @itemOrder.OrderNumber || @itemOrder.CustomerName || <b>PO:</b> @itemOrder.PurchanseOrderNumber
                            <span class="badge bg-pending">@itemOrder.OrderStatus</span>
                        </h6>
                        <p class="mb-2 orderDes">@itemOrder.Project</p>
                    </div>
                    <div class="text-end">
                         @if (Convert.ToInt16(itemOrder.NumberUsageBudget) > 100)
                        {
                            <h5 class="fw-bold" style="color:red">
                                @itemOrder.RemainingBudget
                            </h5>
                        }
                        else
                        {
                            <h5 class="fw-bold">
                                @itemOrder.RemainingBudget
                            </h5>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-4 mb-2">
                    <div class="flex items-center text-sm text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar mr-2"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                        @if (itemOrder.orderItems.Count > 0 && !string.IsNullOrWhiteSpace(itemOrder.orderItems[0].OrderStartDate))
                        {
                            @(itemOrder.orderItems[0].OrderStartDate
                                            + " to " + itemOrder.orderItems[0].OrderEndDate)
                                }
                    </div><div class="flex items-center text-sm text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text mr-2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                        @itemOrder.TotalOrderItemCount
                    </div>
                    <div class="flex items-center text-sm text-green-600 budget">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle mr-2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
                        Budget: @itemOrder.UsageBudget / @itemOrder.TotalBudget
                    </div>
                </div>
                <div class="mb-4 budgetProgress">
                    <div class="d-flex align-items-center justify-content-between text-sm text-gray-600 mb-1">
                        <span>Budget Usage</span>
                        <span>@itemOrder.PercentageUsageBudget</span>
                    </div>
                    @if (Convert.ToInt16(itemOrder.NumberUsageBudget) > 100)
                    {
                        <div class="progress-bar green"
                             role="progressbar"
                             style="width: @itemOrder.PercentageUsageBudget; background-color:red !important"
                             aria-valuenow="@itemOrder.NumberUsageBudget"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    }
                    else
                    {

                        <div class="progress-bar green"
                             role="progressbar"
                             style="width: @itemOrder.PercentageUsageBudget;"
                             aria-valuenow="@itemOrder.NumberUsageBudget"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    }
                </div>

                <div class="bg-gray-50 rounded-lg p-4 mb-2 order-details">
                    <h6 class="font-medium text-gray-900 mb-2">Order Items</h6>
                    <div class="space-y-2">
                        @foreach (var item in itemOrder.orderItems)
                        {
                            <div class="d-flex align-items-center justify-content-between text-sm">
                                <span><b>@item.Category </b> - @item.OrderItemName (x @item.Quantity)</span>
                                <span class="font-medium"> $@item.OrderItemPrice</span>
                            </div>
                        }
                    </div>
                </div>

                <p class="small text-muted mb-3 noteSec"><span class="font-medium">Notes:</span> @itemOrder.Notes</p>
                <!-- Action Buttons -->
                <div class="d-flex gap-2 orderListButtonGroup">
                    <button class="btn btn-outline-secondary btn-sm view-details-btn" type="button" data-order-id="@itemOrder.Id">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text mr-1"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                        View Details
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#editOrderDetails" class="btn btn-outline-primary btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen mr-1"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                        Edit Order
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#deleteOrderDetails" class="btn btn-outline-danger btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 mr-1"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>
                        Delete Order
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#extendRentalDetails" class="btn btn-outline-info btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus mr-1"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                        Extend Rental
                    </button>
                    <button type="button" class="btn btn-success btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download mr-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                        Download Invoice
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#ReOrderDetails" class="btn btn-outline-warning btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw mr-1"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
                        Re-Order
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#CallRentDetails" class="btn btn-outline-call-off btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock mr-1"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Call-Off Rent
                    </button>
                </div>
            </div>
        </div>
    }
}