@using ViewModels.MyOrder
@model AllOrderDropDownViewModel
<style>
    .orderTitle {
        font-weight: 500;
        font-size: 18px;
    }

    .orderDes {
        font-size: 16px;
        font-weight: 400;
    }

    .budget {
        color: #16a34a;
    }

    .order-details {
        background: #f9fafb;
        border-radius: 10px;
    }

    .noteSec {
        font-size: 14px;
        font-weight: 400;
    }

        .noteSec span {
            font-weight: 500;
        }

    .orderListButtonGroup .btn {
        padding: 0.25rem 0.75rem;
        font-size: .875rem;
        line-height: 1.25rem;
        border: none;
    }

        .orderListButtonGroup .btn.btn-outline-secondary {
            background-color: #f3f4f6;
            color: #374151;
        }

        .orderListButtonGroup .btn.btn-outline-primary {
            background-color: #fef9c3;
            color: #a16207;
        }

        .orderListButtonGroup .btn.btn-outline-danger {
            background-color: #fee2e2;
            color: #b91c1c;
        }

        .orderListButtonGroup .btn.btn-outline-info {
            background-color: #dbeafe;
            color: #1d4ed8;
        }

        .orderListButtonGroup .btn.btn-outline-sucess {
            background-color: #dcfce7;
            color: #15803d;
        }

        .orderListButtonGroup .btn.btn-outline-warning {
            background-color: #f3e8ff;
            color: #7e22ce;
        }

        .orderListButtonGroup .btn.btn-outline-call-off {
            background-color: #ffedd5;
            color: #c2410c;
        }

    .orderFilter .nav-item .nav-link {
        background: #f3f4f6;
        color: #374151;
        font-size: .875rem;
        line-height: 1.25rem;
        margin-right: 14px;
    }

        .orderFilter .nav-item .nav-link.active {
            background: #f54e00;
            color: #ffffff;
        }

    .badge {
        font-size: 14px;
        font-weight: 500;
        border-radius: 999px;
        padding: 8px 15px;
        margin-left: 10px;
    }

        .badge.bg-pending {
            color: #a16207;
            background-color: #fef9c3;
        }

    .updateStatusDropDown label {
        font-size: 14px;
        color: #1f1f1f;
    }

    #CallRentDetails p.mb-4 {
        font-size: 16px;
        font-weight: 400;
    }

    #CallRentDetails label.form-label,
    #ReOrderDetails label.form-label,
    #extendRentalDetails label.form-label,
    #editOrderDetails label.form-label {
        font-size: 16px;
        font-weight: 400;
    }

        #CallRentDetails label.form-label.fw-semibold,
        #ReOrderDetails label.form-label.fw-semibold,
        #editOrderDetails label.form-label.fw-semibold {
            font-size: 16px;
            font-weight: 400 !important;
        }

    #CallRentDetails .alert.alert-warning {
        background-color: #ffedd5;
        color: #c2410c;
    }

    #ReOrderDetails .alert.alert-reorder {
        background-color: #f3e8ff;
        color: #7e22ce;
    }

    #extendRentalDetails .alert.alert-primary {
        background-color: #dbeafe;
        color: #1d4ed8;
    }

    #editOrderDetails .alert.alert-editing {
        background-color: #fef9c3;
        color: #a16207;
    }

    .extendRentalCard .card-body {
        border: 1px solid #eeeeee;
        border-radius: 10px;
    }

    #viewOrderDetails .orderDetailTitle {
        font-size: 18px;
    }

    #viewOrderDetails .val {
        font-size: 14px;
        font-weight: 600;
    }

    #viewOrderDetails .title {
        font-size: 14px;
        font-weight: 400;
    }

    .setting-page-search.filter_wrap form > div {
        border-radius: 4px;
    }

    .setting-page-search.filter_wrap form.filter input:not([type="checkbox"]) {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #8898AA;
    }

    .reportFilter .control_field {
        width: 100%;
        border-radius: 10px;
        border-color: #8898AA;
        color: #8898AA;
        background: #fff;
    }

    .reportFilter {
        margin: 0;
        padding: 0;
    }

    .filter_wrap form.filter select {
        height: 36px;
        border: 1px solid #8898AA !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>My Orders</h3>
    <a href="/Inventories" class="btn btn-primary">+ New Order</a>
</div>



<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <!-- Status Tabs -->
    <ul class="nav nav-pills orderFilter" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-all-order-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-all-order" type="button" role="tab">
                All Orders <span id="allOrderCount">(@ViewBag.AllOrderCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-pending-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-pending" type="button" role="tab">
                Pending Approval <span id="pendingApprovalOrderCount">(@ViewBag.PendingApprovalCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-scheduled-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-scheduled" type="button" role="tab">
                Scheduled <span id="scheduledCountOrderCount">(@ViewBag.ScheduledCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-delivered-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-delivered" type="button" role="tab">
                Delivered <span id="deliveredCountOrderCount">(@ViewBag.DeliveredCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-onrent-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-onrent" type="button" role="tab">
                On Rent <span id="onRentCountOrderCount">(@ViewBag.OnRentCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-offrent-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-offrent" type="button" role="tab">
                Off Rent <span id="offRentCountOrderCount">(@ViewBag.OffRentCount)</span>
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link " id="pills-returned-tab" data-bs-toggle="pill"
                    data-bs-target="#pills-returned" type="button" role="tab">
                Returned <span id="returnedCountOrderCount">(@ViewBag.ReturnedCount)</span>
            </button>
        </li>

    </ul>
</div>

<div class="bg-white rounded p-4 shadow-sm border border-gray-200 mb-4">
    <!-- Filter -->
    <div class="filter_wrap setting-page-search reportFilter">
        <form class=" filter search-form" id="report-filter-form" method="post">
            <div class="control_field">
                <input type="search" class="form-control" placeholder="Keyword" autocomplete="new-password" id="Search_value" value="">
            </div>

            <div class="control_field">
                <div class="form-group">
                    <select class="form-control text-xs px-2 py-1 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500" name="CustomerId">
                        <option value="">Select Customer</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.CompanyName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="control_field">
                <div class="form-group">
                    <select class="form-control text-xs px-2 py-1 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500" name="ProjectId">
                        <option value="">Select Project</option>
                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Id">@project.JobName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="control_field">
                <input type="search" class="form-control" placeholder="Search PO" autocomplete="new-password" id="Search_PO" value="">
            </div>



            <div class="actions_field">
                <button type="button" class="clear btn clear-form-btn border text-primary clear-filters">
                    Clear
                </button>
                <button type="button" class="btn btn-primary search-form-btn">
                    Search
                </button>
            </div>

        </form>
    </div>
</div>


<!-- Orders List -->
<div class="tab-content" id="pills-tabContent">
    <div class="tab-pane fade show active" id="pills-all-order" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-pending" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-scheduled" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-delivered" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-offrent" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-onrent" role="tabpanel">
    </div>
    <div class="tab-pane fade" id="pills-returned" role="tabpanel">
    </div>
</div>

<script>
    $(document).ready(function() {

        $(".clear-filters").on('click', function() {
                $('#Search_value').val('');
                $('select[name="CustomerId"]').val('');
                    $('select[name="ProjectId"]').val('');
                   $('#Search_PO').val('');

                    $('.search-form-btn').trigger("click");
        })

        $('.search-form-btn').on('click', function() {
            var keyword = $('#Search_value').val();
            var customerId = $('select[name="CustomerId"]').val();
            var projectId = $('select[name="ProjectId"]').val();
            var poNumber = $('#Search_PO').val();
            var activeTab = $("#pills-tab").find('.active span').attr('id');

            if(activeTab === 'allOrderCount') {
               $.get('@Url.Action("AllOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                $("#pills-all-order").empty();
                $('#pills-all-order').html(data);
            });
            } else  if(activeTab === 'pendingApprovalOrderCount') {
               $.get('@Url.Action("PendingOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                $("#pills-pending").empty();
                $('#pills-pending').html(data);
            });
            }
            else  if(activeTab === 'scheduledCountOrderCount') {
               $.get('@Url.Action("ScheduledOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                   $("#pills-scheduled").empty();
                   $("#pills-scheduled").html(data);
            });
            }
            else  if(activeTab === 'deliveredCountOrderCount') {
               $.get('@Url.Action("DeliveredOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                    $("#pills-delivered").empty();
                    $("#pills-delivered").html(data);
            });
            }
            else  if(activeTab === 'onRentCountOrderCount') {
               $.get('@Url.Action("OnrentOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                    $("#pills-onrent").empty();
                    $("#pills-onrent").html(data);
            });
            }
            else  if(activeTab === 'offRentCountOrderCount') {
               $.get('@Url.Action("OffrentOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                    $("#pills-offrent").empty();
                    $("#pills-offrent").html(data);
            });
            }
            else  if(activeTab === 'returnedCountOrderCount') {
               $.get('@Url.Action("ReturnedOrders", "MyOrders")', {
                keyword: keyword,
                customerId: customerId,
                projectId: projectId,
                poNumber: poNumber
            }, function(data) {
                    $("#pills-returned").empty();
                    $("#pills-returned").html(data);
            });
            }
        });
    });
</script>





<div class="modal fade" id="extendRentalDetails" tabindex="-1" aria-labelledby="extendRentalDetailsModalLabel" aria-hidden="true">
