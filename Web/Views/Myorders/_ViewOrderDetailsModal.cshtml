@using ViewModels.MyOrder
@model AllOrderViewModel

<div class="modal fade" id="viewOrderDetailsById" tabindex="-1" aria-labelledby="viewOrderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewOrderDetailsModalLabel">Order Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <!-- Order Information -->
                    <div class="col-md-6">
                        <h6 class="orderDetailTitle">Order Information</h6>
                        <div class="mb-2 d-flex justify-content-between"><span class="title">Order ID:</span><span class="fw-semibold val"> @Model.OrderNumber</span></div>
                        <div class="mb-2 d-flex justify-content-between"><span class="title">Customer:</span><span class="fw-semibold val"> @Model.CustomerName </span></div>
                        <div class="mb-2 d-flex justify-content-between"><span class="title">Project:</span> <span class="fw-semibold val"> @Model.Project</span></div>
                        <div class="mb-2 d-flex justify-content-between"><span class="title">Purchase Order:</span> <span class="fw-semibold val"> @Model.PurchanseOrderNumber </span></div>
                        <div class="mb-2 d-flex justify-content-between"><span class="title">Work Step:</span> <span class="fw-semibold val"> @Model.WorkStepName</span></div>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="title">Status:</span>
                            <span class="badge bg-success bg-opacity-25 text-success">@Model.OrderStatus</span>
                        </div>
                      
                    </div>

                    <!-- Budget Information -->
                    <div class="col-md-6">
                        <div class="mb-2 d-flex justify-content-between">
                            <spa class="title" n>Start Date:</spa><span class="fw-semibold val">
                                @if (Model.orderItems.Count > 0 && !string.IsNullOrWhiteSpace(Model.orderItems[0].OrderStartDate))
                                {
                                    @(Model.orderItems[0].OrderStartDate)
                                }
                            </span>
                        </div>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="title">End Date:</span><span class="fw-semibold val">
                                @if (Model.orderItems.Count > 0 && !string.IsNullOrWhiteSpace(Model.orderItems[0].OrderStartDate))
                                {
                                    @(Model.orderItems[0].OrderEndDate)
                                }
                            </span>
                        </div>
                        <div class="mb-2 d-flex justify-content-between">Total Cost: <span class="fw-bold fs-5">$@Model.TotalCost</span></div>
                        <h6 class="orderDetailTitle">Budget Information</h6>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="title">Budget Used:</span>
                            <span class="fw-semibold val">$@Model.UsageBudget</span>
                        </div>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="title">Total Budget:</span>
                            <span class="fw-semibold val">$@Model.TotalBudget</span>
                        </div>
                        <div class="mb-2 d-flex justify-content-between">
                            <span class="title">Remaining:</span>
                            <span class="fw-semibold val">$ @(Model.RemainingBudget)</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            @* <div class="progress-bar bg-success" role="progressbar" style="width: 52%;" aria-valuenow="52" aria-valuemin="0" aria-valuemax="100"></div> *@
                        </div>
                    </div>
                </div>

                <!-- Order Items Table -->
                <div class="mt-4">
                    <h6 class="orderDetailTitle">Order Items</h6>
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var itemOrder in Model.orderItems)
                            {
                                <tr>
                                    <td class="fw-semibold">@itemOrder.OrderItemName</td>
                                    <td>@itemOrder.Category</td>
                                    <td>@itemOrder.Quantity</td>
                                    <td>$@itemOrder.OrderItemPrice</td>
                                    <td class="fw-semibold">
                                        $@itemOrder.Total
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Notes Section -->
                <div class="mt-4">
                    <h6 class="orderDetailTitle">Notes</h6>
                    <div class="p-3 bg-light rounded">
                        @Model.Notes
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>