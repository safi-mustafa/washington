@using ViewModels
@using ViewModels.Shared.Notes
@model List<INotesViewModel>

@{
    Layout = null;
    var CPId = ViewBag.CPId;
}

@await Html.PartialAsync("~/Views/Shared/Notes/_NotesPartialView.cshtml", Model, new ViewDataDictionary(ViewData) { { "ParentId", CPId }, { "ParentName", "CustomerProjectId" } })

<script src="~/js/views/notes/notes.js"></script>
<script>
    $(function () {
        notesUrl = "/CustomerProject/SaveCustomerProjectNotes";
        closeNotesModalOnSubmit = false;
    })

    function getNotesList() {
        $.get("/CustomerProject/GetNotesByCustomerProjectId/" + @CPId, function (response) {
            $("#notes-list-container tbody").html($(response).find("tbody").html());
        });
    }
</script>
