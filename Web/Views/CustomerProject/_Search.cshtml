@using ViewModels.CustomerProject
@model CustomerProjectSearchViewModel

<div class="col-12 col-sm-3 col-lg-2">
    <div class="mb-3 form-group">
        <input asp-for="Search.value" type="search" class="form-control" placeholder="Keyword" aria-controls="crud-list-table" autocomplete="new-password">
    </div>
</div>
<div class="control_field" data-filter-id="customerid">
    <partial name="~/Views/Shared/Select2/CustomerProject/_CustomerProject.cshtml" for="Customer" view-data='new ViewDataDictionary(ViewData) { { "HideLabel", true }, { "Id", "customerid-search-id" } }' />
</div>
<div class="control_field" data-filter-id="projectmanagerid">
    <partial name="~/Views/Shared/Select2/ProjectManager/_ProjectManager.cshtml" for="Customer" view-data='new ViewDataDictionary(ViewData) { { "HideLabel", true }, { "Id", "projectmanagerid-search-id" } }' />
</div>