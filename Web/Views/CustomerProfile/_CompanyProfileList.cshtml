            <td>
                <button type="button" class="btn btn-sm btn-primary me-1" onclick="editJobSite(${i})"><i class="fa fa-edit"></i></button>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeJobSite(${i})"><i class="fa fa-trash"></i></button>
            </td>
        `;
        
        tableBody.appendChild(row);
    });


        }
        window.editJobSite = function(idx) {
            const jobSite = window.jobSites[idx];
            const siteName = jobSite.siteName || jobSite.SiteName || '';
            const contactName = jobSite.contactName || jobSite.ContactName || '';
            const contactEmail = jobSite.contactEmail || jobSite.ContactEmail || '';
            const contactMobile = jobSite.contactMobile || jobSite.ContactMobile || '';
            const notes = jobSite.notes || jobSite.Notes || '';
            
            document.getElementById('siteName').value = siteName;
            document.getElementById('jobContactPersonName').value = contactName;
            document.getElementById('jobContactPersonEmail').value = contactEmail;
            document.getElementById('jobContactPersonMobile').value = contactMobile;
            document.getElementById('specialNotes').value = notes;
            
            window.editingJobSiteIndex = idx;
        };
        
        window.removeJobSite = function(idx) {
            window.jobSites.splice(idx, 1);
            window.renderJobSites();
        };

        // Form submission
        window.currentCompanyId = null;
        
        document.getElementById('submitForm').addEventListener('click', function() {
            // Validate all required fields
            const companyInfoValid = validateTab('company-info');
            
            if (!companyInfoValid) {
                // Switch to company info tab to show errors
                var tab = new bootstrap.Tab(document.querySelector('#company-info-tab'));
                tab.show();
                return;
            }
            
            const formData = {
                CompanyName: document.getElementById('companyName').value,
                Industry: document.getElementById('industry').value,
                Street: document.getElementById('street').value,
                City: document.getElementById('city').value,
                State: document.getElementById('state').value,
                ZipCode: document.getElementById('zipCode').value,
                Telephone: document.getElementById('telephone').value,
                WebAddress: document.getElementById('webAddress').value,
                Contacts: window.contacts,
                JobSites: window.jobSites
            };

            fetch('/CustomerProfile/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error saving data');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error saving data');
            });
        });

        document.getElementById('updateForm').addEventListener('click', function() {
            // Validate all required fields
            const companyInfoValid = validateTab('company-info');
            
            if (!companyInfoValid) {
                // Switch to company info tab to show errors
                var tab = new bootstrap.Tab(document.querySelector('#company-info-tab'));
                tab.show();
                return;
            }
            
            const formData = {
                Id: window.currentCompanyId,
                CompanyName: document.getElementById('companyName').value,
                Industry: document.getElementById('industry').value,
                Street: document.getElementById('street').value,
                City: document.getElementById('city').value,
                State: document.getElementById('state').value,
                ZipCode: document.getElementById('zipCode').value,
                Telephone: document.getElementById('telephone').value,
                WebAddress: document.getElementById('webAddress').value,
                Contacts: window.contacts,
                JobSites: window.jobSites
            };

            fetch('/CustomerProfile/Update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating data');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error updating data');
            });
        });
    });

    function deleteCompany(deleteUrl) {
        if (confirm('Are you sure you want to delete this company profile?')) {
            fetch(deleteUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error deleting company: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting company');
            });
        }
    }

    function viewCompany(getUrl) {
        fetch(getUrl)
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error loading company data: ' + data.error);
                    return;
                }
                
                // Fill form fields
                document.getElementById('companyName').value = data.CompanyName || '';
                document.getElementById('industry').value = data.Industry || '';
                document.getElementById('street').value = data.Street || '';
                document.getElementById('city').value = data.City || '';
                document.getElementById('state').value = data.State || '';
                document.getElementById('zipCode').value = data.ZipCode || '';
                document.getElementById('telephone').value = data.Telephone || '';
                document.getElementById('webAddress').value = data.WebAddress || '';
                
                // Load contacts and job sites
                window.contacts = data.Contacts || [];
                window.renderContacts();
                window.jobSites = data.JobSites || [];
                window.renderJobSites();
                
                // Set all fields to readonly
                document.querySelectorAll('#companyProfileForm input, #companyProfileForm select, #companyProfileForm textarea').forEach(field => {
                    field.readOnly = true;
                    field.disabled = true;
                });
                
                // Add view-mode class to hide input fields in contacts and job sites
                document.getElementById('addCompanyProfileModal').classList.add('view-mode');
                
                // Hide action buttons
                document.getElementById('nextToContacts').style.display = 'none';
                document.getElementById('prevToInfo').style.display = 'none';
                document.getElementById('saveContact').style.display = 'none';
                document.getElementById('nextToJobSites').style.display = 'none';
                document.getElementById('prevToContacts').style.display = 'none';
                document.getElementById('saveJobSite').style.display = 'none';
                document.getElementById('submitForm').style.display = 'none';
                document.getElementById('updateForm').style.display = 'none';
                
                // Update modal title
                document.getElementById('addCompanyProfileModalLabel').textContent = 'View Company Profile';
                
                // Show modal
                var modal = new bootstrap.Modal(document.getElementById('addCompanyProfileModal'));
                modal.show();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error loading company data');
            });
    }

    function editCompany(getUrl) {
        fetch(getUrl)
            .then(response => response.json())
            .then(data => {
                debugger
                if (data.error) {
                    alert('Error loading company data: ' + data.error);
                    return;
                }
                
                // Fill form fields
                document.getElementById('companyName').value = data.CompanyName || '';
                document.getElementById('industry').value = data.Industry || '';
                document.getElementById('street').value = data.Street || '';
                document.getElementById('city').value = data.City || '';
                document.getElementById('state').value = data.State || '';
                document.getElementById('zipCode').value = data.ZipCode || '';
                document.getElementById('telephone').value = data.Telephone || '';
                document.getElementById('webAddress').value = data.WebAddress || '';
                
                // Store company ID for update
                window.currentCompanyId = data.Id;
                
                // Load contacts
                window.contacts = data.Contacts || [];
                window.renderContacts();
                
                // Load job sites
                window.jobSites = data.JobSites || [];
                window.renderJobSites();
                
                // Reset readonly state for editing
                document.querySelectorAll('#companyProfileForm input, #companyProfileForm select, #companyProfileForm textarea').forEach(field => {
                    field.readOnly = false;
                    field.disabled = false;
                });
                
                // Remove view-mode class
                document.getElementById('addCompanyProfileModal').classList.remove('view-mode');
                
                // Show action buttons
                document.getElementById('nextToContacts').style.display = 'inline-block';
                document.getElementById('prevToInfo').style.display = 'inline-block';
                document.getElementById('saveContact').style.display = 'inline-block';
                document.getElementById('nextToJobSites').style.display = 'inline-block';
                document.getElementById('prevToContacts').style.display = 'inline-block';
                document.getElementById('saveJobSite').style.display = 'inline-block';
                
                // Update row index
                window.rowIndex = Math.max(window.contacts.length, window.jobSites.length);
                
                // Change modal title and button
                document.getElementById('addCompanyProfileModalLabel').textContent = 'Update Company Profile';
                document.getElementById('submitForm').style.display = 'none';
                document.getElementById('updateForm').style.display = 'inline-block';
                
                // Show modal
                var modal = new bootstrap.Modal(document.getElementById('addCompanyProfileModal'));
                modal.show();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error loading company data');
            });
    }

    function resetModalForAdd() {
        // Reset form
        document.getElementById('companyProfileForm').reset();
        
        // Clear arrays
        window.contacts = [];
        window.jobSites = [];
        window.currentCompanyId = null;
        window.editingContactIndex = -1;
        window.editingJobSiteIndex = -1;
        
        // Clear lists
        document.getElementById('contactsList').innerHTML = '';
        document.getElementById('jobSitesList').innerHTML = '';
        
        // Reset readonly state
        document.querySelectorAll('#companyProfileForm input, #companyProfileForm select, #companyProfileForm textarea').forEach(field => {
            field.readOnly = false;
            field.disabled = false;
        });
        
        // Remove view-mode class
        document.getElementById('addCompanyProfileModal').classList.remove('view-mode');
        
        // Show action buttons
        document.getElementById('nextToContacts').style.display = 'inline-block';
        document.getElementById('prevToInfo').style.display = 'inline-block';
        document.getElementById('saveContact').style.display = 'inline-block';
        document.getElementById('nextToJobSites').style.display = 'inline-block';
        document.getElementById('prevToContacts').style.display = 'inline-block';
        document.getElementById('saveJobSite').style.display = 'inline-block';
        
        // Reset modal title and buttons
        document.getElementById('addCompanyProfileModalLabel').textContent = 'Add New Company Profile';
        document.getElementById('submitForm').style.display = 'inline-block';
        document.getElementById('updateForm').style.display = 'none';
        
        // Reset to first tab
        var tab = new bootstrap.Tab(document.querySelector('#company-info-tab'));
        tab.show();
    }

    // Ensure first tab is selected when modal opens
    document.getElementById('addCompanyProfileModal').addEventListener('shown.bs.modal', function () {
        var tab = new bootstrap.Tab(document.querySelector('#company-info-tab'));
        tab.show();
    });
</script>
