@model ViewModels.CustomerProfile.CustomerProfileViewModel
<style>
    /**********************Common CSS for new design 12-08-25 by dhara*************************/
    .btn.CommonAddBtn {
        font-size: 17px;
    }

    .CommonListCard .company-info {
        color: #999999;
        font-size: 15px;
    }

    .CommonListCard .websiteLink {
        color: #F54E00;
    }

    .small-card {
        background: #f54e0012;
    }

        .small-card .fw-bold {
            font-size: 18px;
        }

        .small-card .text-muted {
            font-family: sans-serif;
            font-size: 14px;
        }

    .dateInfo {
        font-size: 14px;
        font-family: sans-serif;
    }

    .ButtonGroup .btn-link:hover{
        background: #e22335 !important;
        color: #fff !important;

    }

    .CustomTab .nav-link {
        border:none;
        color: #2f2f2f !important;
        border-bottom: 1px solid #dee2e6 !important;
    }

    .CustomTab .nav-link:hover {
        color: #000 !important;
        border-bottom: 0px solid #000 !important;
    }
    .CustomTab .nav-link.active{
            color: #f54e00 !important;
            border-bottom: 1px solid #f54e00 !important;
    }
    .CustomTab .nav-link.active:hover{
                color: #f54e00 !important;
        border-bottom: 1px solid #f54e00 !important;
    }

    .CustomTab .nav-item {
        margin-bottom: 0 !important;
    }

    .CustomTab .nav-link .fa {
        margin-right: 10px !important;
    }

    .InfoCard {
        border-radius: 6px;
        background: #f7f7f7;
    }

    .is-invalid {
        border-color: #dc3545;
    }

    .invalid-feedback {
        display: block;
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }

    .view-mode .contact-inputs,
    .view-mode .jobsite-inputs {
        display: none;
    }

    .view-mode .btn-danger,
    .view-mode .btn-primary {
        display: none;
    }

    .view-mode th:last-child,
    .view-mode td:last-child {
        display: none;
    }

    .shoppingCartIcon {
        background-color: #F54E00 !important;
        color: #ffffff !important;
        position: relative;
        padding: 10px 15px;

    }

    .shoppingCartIcon .count {
        border: 1px solid;
        position: absolute;
        top: -10px;
        right: -10px;
    }

</style>

<div class="companyProfile">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Model.Title</h4>
            <div class="text-muted fs-6">Manage your company profiles and related information</div>
        </div>
        <div class="btnGroup">
            <button type="button" class="btn btn-primary btn-lg CommonAddBtn" onclick="resetModalForAdd()" data-bs-toggle="modal" data-bs-target="#addCompanyProfileModal">
                <i class="fa fa-plus me-2"></i> Add New Company Profile
            </button>
            <a class="btn btn-light bg-white shoppingCartIcon" href="/Cart/Step1">
                <div class="count" id="divshoppingcartlayout">0</div>
                <i class="fa fa-shopping-cart"></i>
            </a>
        </div>
    </div>
    <div class="row g-4">
        @foreach (var company in Model.CompanyProfiles ?? Enumerable.Empty<ViewModels.CustomerProfile.CompanyProfileViewModel>())
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm CommonListCard">
                    <div class="card-body">
                        <h5 class="fw-bold">@company.Name</h5>
                        <div class="mb-2 text-secondary">@company.Industry</div>
                         <div class="mb-2">
                            <div class="company-info"><i class="fa fa-location-dot"></i>  @company.Location</div>
                            <div class="company-info"><i class="fa fa-phone"></i>  @company.Phone</div>
                            <div class="company-info"><i class="fa fa-globe"></i> <a href="@company.Website" target="_blank" class="websiteLink">Website</a></div>
                        </div>
                        @* <div class="mb-2 ">
                            <i class="fa fa-location-dot me-1"></i> @company.Location
                        </div>
                        <div class="mb-2">
                            <i class="fa fa-phone me-1"></i> @company.Phone
                        </div>
                        <div class="mb-2">
                            <i class="fa fa-globe me-1"></i> <a href="@company.Website" target="_blank">Website</a>
                        </div> *@
                        @* <div class="row text-center my-3">
                            <div class="col">
                                <div class="fw-bold fs-4"></div>
                                <div class="text-muted">Contacts</div>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-4">@company.JobSitesCount</div>
                                <div class="text-muted">Job Sites</div>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-4">@company.ProjectsCount</div>
                                <div class="text-muted">Projects</div>
                            </div>
                        </div> *@
                        <div class="d-flex text-center mb-3">
                            <div class="flex-fill  rounded p-2 me-1 small-card">
                                <div class="fw-bold">@company.ContactsCount</div>
                                <small class="text-muted">Contacts</small>
                            </div>
                            <div class="flex-fill  rounded p-2 me-1 small-card">
                                <div class="fw-bold">@company.JobSitesCount</div>
                                <small class="text-muted">Job Sites</small>
                            </div>
                            <div class="flex-fill  rounded p-2 small-card">
                                <div class="fw-bold">@company.ProjectsCount</div>
                                <small class="text-muted">Projects</small>
                            </div>
                        </div>
                        <div class="text-muted small mb-2 DateInformation">
                            <small class="text-muted d-block dateInfo">
                                Created: @company.CreatedDate.ToShortDateString()
                            </small>
                            <small class="text-muted d-block mb-3 dateInfo">
                                Updated: @company.UpdatedDate.ToShortDateString()
                            </small>
                        </div>
                        <div class="d-flex gap-2 ButtonGroup">
                            <button type="button" class="btn btn-primary flex-fill" onclick="viewCompany('@company.EditUrl')"><i class="fa fa-eye me-1"></i> View</button>
                            <button type="button" class="btn btn-light flex-fill" onclick="editCompany('@company.EditUrl')"><i class="fa fa-pen me-1"></i> Edit</button>
                            <button type="button" class="btn btn-link text-danger flex-fill" onclick="deleteCompany('@company.DeleteUrl')"><i class="fa fa-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal for Add New Company Profile -->
<div class="modal fade" id="addCompanyProfileModal" tabindex="-1" aria-labelledby="addCompanyProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCompanyProfileModalLabel">Add New Company Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="companyProfileForm">
                    <ul class="nav nav-tabs mb-3 CustomTab" id="companyProfileTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="company-info-tab" data-bs-toggle="tab" data-bs-target="#company-info" type="button" role="tab" aria-controls="company-info" aria-selected="true"><i class="fa fa-building"></i>Company Information</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="company-contacts-tab" data-bs-toggle="tab" data-bs-target="#company-contacts" type="button" role="tab" aria-controls="company-contacts" aria-selected="false"><i class="fa fa-users"></i>Company Contacts</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="job-sites-tab" data-bs-toggle="tab" data-bs-target="#job-sites" type="button" role="tab" aria-controls="job-sites" aria-selected="false"><i class="fa fa-location-dot"></i>Job Sites</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="companyProfileTabContent">
                        <div class="tab-pane fade show active" id="company-info" role="tabpanel" aria-labelledby="company-info-tab">
                            <div class="shadow-sm border border-gray-200 card-body InfoCard">
                                <h6 class="fw-bold mb-3">Company Information</h6>
                                <div class="mb-3">
                                    <label class="form-label">Company Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="companyName" required />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Industry <span class="text-danger">*</span></label>
                                    <select class="form-select" id="industry" required>
                                        <option value="">Select Industry</option>
                                        <option>Oil & Gas</option>
                                        <option>Construction</option>
                                        <option>Other</option>
                                    </select>
                                    <div class="invalid-feedback"></div>
                                </div>
                                <fieldset class="mb-3">
                                    <legend class="fs-6">Address</legend>
                                    <div class="row g-2">
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">Street <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="street" required />
                                            <div class="invalid-feedback"></div>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">City <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="city" required />
                                            <div class="invalid-feedback"></div>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">State <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="state" required />
                                            <div class="invalid-feedback"></div>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">Zip Code <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="zipCode" required pattern="[0-9]{5}(-[0-9]{4})?" />
                                            <div class="invalid-feedback"></div>
                                        </div>
                                    </div>
                                </fieldset>
                                <div class="mb-3">
                                    <label class="form-label">Telephone <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" id="telephone" required pattern="[0-9\-\(\)\+\s]{10,}" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Web Address</label>
                                    <input type="url" class="form-control" id="webAddress" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-primary" id="nextToContacts">Next</button>
                                </div>
                            </div>

                        </div>
                        <div class="tab-pane fade" id="company-contacts" role="tabpanel" aria-labelledby="company-contacts-tab">
                            <div class="shadow-sm border border-gray-200 card-body InfoCard">
                                <h6 class="fw-bold mb-3">Company Contacts</h6>
                                <div class="contact-inputs">
                                    <div class="mb-3">
                                        <label class="form-label">Contact Person Name</label>
                                        <input type="text" class="form-control" id="contactPersonName" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Role</label>
                                        <select class="form-select" id="contactRole">
                                            <option value="">Select Role</option>
                                            <option>Project Manager</option>
                                            <option>Admin</option>
                                        </select>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Phone Number</label>
                                        <input type="tel" class="form-control" id="contactPhone" pattern="[0-9\-\(\)\+\s]{10,}" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email Address</label>
                                        <input type="email" class="form-control" id="contactEmail" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-secondary" id="prevToInfo">Previous</button>
                                        <button type="button" class="btn btn-success" id="saveContact">Save</button>
                                        <button type="button" class="btn btn-primary" id="nextToJobSites">Next</button>
                                    </div>
                                </div>
                                <div class="mt-5 savedDetail">
                                    <h6>Saved Contacts</h6>
                                    <ul class="list-group" id="contactsList"></ul>
                                </div>
                            </div>

                        </div>
                        <div class="tab-pane fade" id="job-sites" role="tabpanel" aria-labelledby="job-sites-tab">
                            <div class="shadow-sm border border-gray-200 card-body InfoCard">
                                <h6 class="fw-bold mb-3">Job Sites</h6>
                                <div class="jobsite-inputs">
                                    <div class="mb-3">
                                        <label class="form-label">Site Name</label>
                                    <input type="text" class="form-control" id="siteName" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Contact Person Name</label>
                                    <input type="text" class="form-control" id="jobContactPersonName" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Contact Person's Email</label>
                                    <input type="email" class="form-control" id="jobContactPersonEmail" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Contact Person's Mobile</label>
                                    <input type="tel" class="form-control" id="jobContactPersonMobile" />
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Special Notes</label>
                                    <textarea class="form-control" id="specialNotes"></textarea>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-secondary" id="prevToContacts">Previous</button>
                                    <button type="button" class="btn btn-success" id="saveJobSite">Save</button>
                                    <button type="button" class="btn btn-primary" id="submitForm">Submit</button>
                                    <button type="button" class="btn btn-success" id="updateForm" style="display:none;">Update</button>
                                    </div>
                                </div>
                                <div class="mt-5 savedDetail">
                                    <h6>Saved Job Sites</h6>
                                    <ul class="list-group" id="jobSitesList"></ul>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Validation functions
        function validateField(field) {
            const value = field.value.trim();
            const isValid = field.checkValidity() && value !== '';
            
            field.classList.toggle('is-invalid', !isValid);
            
            const feedback = field.nextElementSibling;
            if (feedback && feedback.classList.contains('invalid-feedback')) {
                if (!isValid) {
                    if (field.type === 'email') {
                        feedback.textContent = 'Please enter a valid email address.';
                    } else if (field.type === 'tel') {
                        feedback.textContent = 'Please enter a valid phone number (minimum 10 digits).';
                    } else if (field.type === 'url') {
                        feedback.textContent = 'Please enter a valid URL.';
                    } else if (field.id === 'zipCode') {
                        feedback.textContent = 'Please enter a valid zip code (e.g., 12345 or 12345-6789).';
                    } else {
                        feedback.textContent = 'This field is required.';
                    }
                } else {
                    feedback.textContent = '';
                }
            }
            
            return isValid;
        }

        function validateTab(tabId) {
            const tab = document.getElementById(tabId);
            const fields = tab.querySelectorAll('input[required], select[required]');
            let isValid = true;
            
            fields.forEach(field => {
                if (!validateField(field)) {
                    isValid = false;
                }
            });
            
            return isValid;
        }

        // Add real-time validation
        document.querySelectorAll('input, select, textarea').forEach(field => {
            field.addEventListener('blur', () => validateField(field));
            field.addEventListener('input', () => {
                if (field.classList.contains('is-invalid')) {
                    validateField(field);
                }
            });
        });

        // Tab navigation with validation
        document.getElementById('nextToContacts').addEventListener('click', function () {
            if (validateTab('company-info')) {
                var tab = new bootstrap.Tab(document.querySelector('#company-contacts-tab'));
                tab.show();
            }
        });
        document.getElementById('nextToJobSites').addEventListener('click', function () {
            var tab = new bootstrap.Tab(document.querySelector('#job-sites-tab'));
            tab.show();
        });
        document.getElementById('prevToInfo').addEventListener('click', function () {
            var tab = new bootstrap.Tab(document.querySelector('#company-info-tab'));
            tab.show();
        });
        document.getElementById('prevToContacts').addEventListener('click', function () {
            var tab = new bootstrap.Tab(document.querySelector('#company-contacts-tab'));
            tab.show();
        });

        // Company Contacts logic
        window.contacts = [];
        window.editingContactIndex = -1;
        document.getElementById('saveContact').addEventListener('click', function () {
            const nameField = document.getElementById('contactPersonName');
            const roleField = document.getElementById('contactRole');
            const phoneField = document.getElementById('contactPhone');
            const emailField = document.getElementById('contactEmail');
            
            // Validate required fields for saving
            let isValid = true;
            if (!nameField.value.trim()) {
                nameField.classList.add('is-invalid');
                nameField.nextElementSibling.textContent = 'Contact name is required.';
                isValid = false;
            } else {
                nameField.classList.remove('is-invalid');
                nameField.nextElementSibling.textContent = '';
            }
            
            if (!roleField.value) {
                roleField.classList.add('is-invalid');
                roleField.nextElementSibling.textContent = 'Role is required.';
                isValid = false;
            } else {
                roleField.classList.remove('is-invalid');
                roleField.nextElementSibling.textContent = '';
            }
            
            if (!phoneField.value.trim() || !phoneField.checkValidity()) {
                phoneField.classList.add('is-invalid');
                phoneField.nextElementSibling.textContent = 'Valid phone number is required.';
                isValid = false;
            } else {
                phoneField.classList.remove('is-invalid');
                phoneField.nextElementSibling.textContent = '';
            }
            
            if (!emailField.value.trim() || !emailField.checkValidity()) {
                emailField.classList.add('is-invalid');
                emailField.nextElementSibling.textContent = 'Valid email is required.';
                isValid = false;
            } else {
                emailField.classList.remove('is-invalid');
                emailField.nextElementSibling.textContent = '';
            }
            
            if (isValid) {
                const contactData = { 
                    name: nameField.value.trim(), 
                    role: roleField.value, 
                    phone: phoneField.value.trim(), 
                    email: emailField.value.trim() 
                };
                
                if (window.editingContactIndex >= 0) {
                    window.contacts[window.editingContactIndex] = contactData;
                    window.editingContactIndex = -1;
                } else {
                    window.contacts.push(contactData);
                }
                
                window.renderContacts();
                nameField.value = '';
                roleField.selectedIndex = 0;
                phoneField.value = '';
                emailField.value = '';
                
                // Clear validation states
                [nameField, roleField, phoneField, emailField].forEach(field => {
                    field.classList.remove('is-invalid');
                    const feedback = field.nextElementSibling;
                    if (feedback && feedback.classList.contains('invalid-feedback')) {
                        feedback.textContent = '';
                    }
                });
            }
        });
        window.renderContacts = function() {
            const list = document.getElementById('contactsList');
            // list.innerHTML = '';
            // contacts.forEach((c, i) => {
            //     const li = document.createElement('li');
            //      li.className = 'list-group-item d-flex justify-content-between align-items-center';
            //      li.innerHTML = `<span>${c.name} (${c.role}) - ${c.phone} - ${c.email}</span><button type="button" class="btn btn-sm btn-danger" onclick="removeContact(${i})">Remove</button>`;
                
            //     list.appendChild(li);
            // });
            list.innerHTML=`
                <table class="table">
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">Name</th>
                      <th scope="col">Role</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Email</th>
                      <th scope="col">Action</th>
                    </tr>
                  </thead>
                  <tbody id="contactsTableBody"></tbody>
                </table>
                `;

            const tableBody = document.getElementById('contactsTableBody');

                window.contacts.forEach((c, i) => {
        const row = document.createElement('tr');

        const name = c.name?.trim()
            ? c.name
            : (c.Name?.trim() ? c.Name : "");

        const role = c.role?.trim()
            ? c.role
            : (c.Role?.trim() ? c.Role : "");

        const phone = c.phone?.trim()
            ? c.phone
            : (c.Phone?.trim() ? c.Phone : "");

        const email = c.email?.trim()
            ? c.email
            : (c.Email?.trim() ? c.Email : "");

        row.innerHTML = `
            <th scope="row">${i + 1}</th>
            <td>${name}</td>
            <td>${role}</td>
            <td>${phone}</td>
            <td>${email}</td>
            <td>
                <button type="button" class="btn btn-sm btn-primary me-1" onclick="editContact(${i})"><i class="fa fa-edit"></i></button>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeContact(${i})"><i class="fa fa-trash"></i></button>
            </td>
        `;
        
        tableBody.appendChild(row);
    });

        }
        window.editContact = function(idx) {
            const contact = window.contacts[idx];
            const name = contact.name || contact.Name || '';
            const role = contact.role || contact.Role || '';
            const phone = contact.phone || contact.Phone || '';
            const email = contact.email || contact.Email || '';
            
            document.getElementById('contactPersonName').value = name;
            document.getElementById('contactRole').value = role;
            document.getElementById('contactPhone').value = phone;
            document.getElementById('contactEmail').value = email;
            
            window.editingContactIndex = idx;
        };
        
        window.removeContact = function(idx) {
            window.contacts.splice(idx, 1);
            window.renderContacts();
        };

        // Job Sites logic
        window.jobSites = [];
        window.editingJobSiteIndex = -1;
        document.getElementById('saveJobSite').addEventListener('click', function () {
            const siteNameField = document.getElementById('siteName');
            const contactNameField = document.getElementById('jobContactPersonName');
            const contactEmailField = document.getElementById('jobContactPersonEmail');
            const contactMobileField = document.getElementById('jobContactPersonMobile');
            const notesField = document.getElementById('specialNotes');
            
            // Validate required fields for saving
            let isValid = true;
            if (!siteNameField.value.trim()) {
                siteNameField.classList.add('is-invalid');
                siteNameField.nextElementSibling.textContent = 'Site name is required.';
                isValid = false;
            } else {
                siteNameField.classList.remove('is-invalid');
                siteNameField.nextElementSibling.textContent = '';
            }
            
            if (!contactNameField.value.trim()) {
                contactNameField.classList.add('is-invalid');
                contactNameField.nextElementSibling.textContent = 'Contact name is required.';
                isValid = false;
            } else {
                contactNameField.classList.remove('is-invalid');
                contactNameField.nextElementSibling.textContent = '';
            }
            
            if (!contactEmailField.value.trim() || !contactEmailField.checkValidity()) {
                contactEmailField.classList.add('is-invalid');
                contactEmailField.nextElementSibling.textContent = 'Valid email is required.';
                isValid = false;
            } else {
                contactEmailField.classList.remove('is-invalid');
                contactEmailField.nextElementSibling.textContent = '';
            }
            
            if (!contactMobileField.value.trim() || !contactMobileField.checkValidity()) {
                contactMobileField.classList.add('is-invalid');
                contactMobileField.nextElementSibling.textContent = 'Valid mobile number is required.';
                isValid = false;
            } else {
                contactMobileField.classList.remove('is-invalid');
                contactMobileField.nextElementSibling.textContent = '';
            }
            
            if (isValid) {
                const jobSiteData = { 
                    siteName: siteNameField.value.trim(), 
                    contactName: contactNameField.value.trim(), 
                    contactEmail: contactEmailField.value.trim(), 
                    contactMobile: contactMobileField.value.trim(), 
                    notes: notesField.value.trim() 
                };
                
                if (window.editingJobSiteIndex >= 0) {
                    window.jobSites[window.editingJobSiteIndex] = jobSiteData;
                    window.editingJobSiteIndex = -1;
                } else {
                    window.jobSites.push(jobSiteData);
                }
                
                window.renderJobSites();
                siteNameField.value = '';
                contactNameField.value = '';
                contactEmailField.value = '';
                contactMobileField.value = '';
                notesField.value = '';
                
                // Clear validation states
                [siteNameField, contactNameField, contactEmailField, contactMobileField].forEach(field => {
                    field.classList.remove('is-invalid');
                    const feedback = field.nextElementSibling;
                    if (feedback && feedback.classList.contains('invalid-feedback')) {
                        feedback.textContent = '';
                    }
                });
            }
        });
        window.renderJobSites = function() {
            const list = document.getElementById('jobSitesList');
            // list.innerHTML = '';
            // jobSites.forEach((j, i) => {
            //     const li = document.createElement('li');
