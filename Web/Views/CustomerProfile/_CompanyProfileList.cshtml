                        <th scope="col">Action</th>
                    </tr>
                    </thead>
                    <tbody id="jobSitesTableBody"></tbody>
                </table>
                `;

                // Append rows for each job site
                const tableBody = document.getElementById('jobSitesTableBody');

                        window.jobSites.forEach((j, i) => {
        const row = document.createElement('tr');

        const siteName = j.siteName?.trim()
            ? j.siteName
            : (j.SiteName?.trim() ? j.SiteName : "");

        const contactName = j.contactName?.trim()
            ? j.contactName
            : (j.ContactName?.trim() ? j.ContactName : "");

        const contactEmail = j.contactEmail?.trim()
            ? j.contactEmail
            : (j.ContactEmail?.trim() ? j.ContactEmail : "");

        const contactMobile = j.contactMobile?.trim()
            ? j.contactMobile
            : (j.ContactMobile?.trim() ? j.ContactMobile : "");

        row.innerHTML = `
            <th scope="row">${i + 1}</th>
